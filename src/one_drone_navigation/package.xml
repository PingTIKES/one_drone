<?xml version="1.0"?>
<package format="3">
  <name>one_drone_navigation</name>
  <version>0.1.0</version>
  <description>Manual map alignment, depth height slice and Nav2 goal manager</description>
  <maintainer email="team@example.com">PingTIKES</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
