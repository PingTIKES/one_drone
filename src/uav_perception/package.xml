<?xml version="1.0"?>
<package format="3">
  <name>uav_perception</name>
  <version>0.1.0</version>
  <description>Stereo depth and obstacle cloud</description>
  <maintainer email="team@example.com">PingTIKES</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <exec_depend>uav_localization</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
