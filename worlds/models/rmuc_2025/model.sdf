<?xml version='1.0'?>
<!-- 用户提供的短墙 RMUC2025 网格；启动时解压 rmuc_2025_3m.stl.xz。
     网格按场地中心建模，地板 z=-0.2，link 抬升 0.2 m。 -->
<sdf version='1.6'>
  <model name='rmuc_2025'>
    <static>true</static>
    <link name='body'>
      <pose frame=''>0 0 0.2 0 0 0</pose>
      <self_collide>0</self_collide>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://rmuc_2025/meshes/rmuc_2025.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
      </visual>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>model://rmuc_2025/meshes/rmuc_2025.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
